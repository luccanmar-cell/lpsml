# Raw Excel workbooks should stay out of version control.
*.xlsx
*.xslx
*.xls
*.xlsm
*.xlsb

# Python cache files.
__pycache__/
*.py[cod]
.pytest_cache/

# Local datasets and generated artifacts.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/artifacts/training_runs/*
!/artifacts/training_runs/.gitkeep
/artifacts/counterfactual/*
!/artifacts/counterfactual/.gitkeep
